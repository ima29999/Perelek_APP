APP_NAME=perelek
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=perelek
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS="noreply@perelek.local"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

# Midtrans Payment Gateway (Sandbox)
# Ambil dari dashboard.midtrans.com -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# PENTING - Webhook Midtrans (POST /api/webhooks/midtrans):
# Midtrans butuh bisa MENGHUBUNGI BALIK URL backend ini secara langsung dari
# internet untuk mengonfirmasi pembayaran otomatis. Kalau APP_URL masih
# "http://localhost:8000" seperti di atas, Midtrans TIDAK BISA menjangkaunya
# sama sekali, sehingga pembayaran akan nyangkut 'pending' walau sudah
# sukses dibayar, sampai command `payments:sync-midtrans` berjalan (lihat
# app/Console/Kernel.php, dijadwalkan tiap menit) atau ada yang membuka
# halaman pembayaran/tagihan secara manual.
#
# Untuk testing lokal dengan konfirmasi yang benar-benar real-time:
#   1. Jalankan tunnel publik, mis. `ngrok http 8000`
#   2. Daftarkan https://<subdomain-ngrok-anda>/api/webhooks/midtrans sebagai
#      "Payment Notification URL" di dashboard.midtrans.com -> Settings -> Configuration
#   3. (Opsional) set MIDTRANS_FINISH_URL ke URL ngrok tersebut + /payment/finish
#
# Kalau tidak sempat setup ngrok, jalankan manual kapan saja untuk memaksa
# sinkronisasi status pembayaran yang masih pending:
#   php artisan payments:sync-midtrans
MIDTRANS_FINISH_URL=http://localhost:8000/payment/finish
MIDTRANS_UNFINISH_URL=http://localhost:8000/payment/unfinish
MIDTRANS_ERROR_URL=http://localhost:8000/payment/error

# Groq Cloud API - untuk fitur chat AI
# Ambil API key gratis di https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama3-8b-8192
